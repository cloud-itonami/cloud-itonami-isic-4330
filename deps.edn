{:paths ["src"]
 ;; langgraph-clj brings langchain-clj transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM/WASM). It
 ;; lives in the kotoba-lang org of this workspace. This repo is standalone
 ;; (forkable outside the workspace); the :local/root paths only resolve
 ;; inside the monorepo checkout -- a standalone fork should override them
 ;; with git coordinates. `finishing.store` uses `langchain-store.core` for
 ;; the shared EDN-blob codec / identity-schema / entity field-spec
 ;; machinery (ADR-2607141600) instead of hand-rolling it.
 ;;
 ;; This actor is COORDINATION-ONLY (every proposal effect is `:propose`)
 ;; -- it deliberately has NO dependency on `kotoba-lang/robotics` or
 ;; `kotoba-lang/physics-2d`: it never simulates or dispatches
 ;; trade-equipment/crew actions, only proposes, schedules, flags and logs,
 ;; all governor- and human-gated (see README). Per this repo's mandate
 ;; (cljs-first / fully portable `.cljc`, no JVM interop -- ADR pending, see
 ;; superproject AGENTS.md `.cljc`/`.kotoba` runtime priority note),
 ;; `finishing.notify`'s real transport is a plain-function INJECTION seam
 ;; (`fn-notifier`) -- unlike some earlier sibling actors' notify.cljc, this
 ;; repo does NOT embed a `java.net.http`/platform HTTP client itself.
 ;;
 ;; `jp-go-digital-design-system` (DADS -- デジタル庁デザインシステム) is the
 ;; workspace's BASE design system (superproject AGENTS.md "UI/UX 標準"). It is
 ;; used ONLY at build time, by `finishing.render-html`, to style
 ;; `docs/samples/operator-console.html` (`jp-go-dds.skin/dds+skin`). It is a
 ;; git dep rather than `:local/root` so a standalone fork outside the monorepo
 ;; can still regenerate the sample. NOTE: langgraph is ALREADY on :deps above
 ;; as `io.github.com-junkawasaki/langgraph-clj` -- it is deliberately NOT
 ;; re-declared under a second coordinate pointing at the same `:local/root`,
 ;; which would put the same `langgraph.*` namespaces on the classpath twice.
 :deps {
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "96a82d9612d7f3699f93323bad0c68355b8f7cc9"
         :deps/root "lib/kotoba.edn"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "96a82d9612d7f3699f93323bad0c68355b8f7cc9"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "96a82d9612d7f3699f93323bad0c68355b8f7cc9"
         :deps/root "lib/kotoba.text"}
       io.github.com-junkawasaki/langgraph-clj
        {:local/root "../../kotoba-lang/langgraph"}
        io.github.kotoba-lang/langchain-store
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.langchainStore"}
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "e09192276fd6a111dfb9959bfc75ddeba555e840"
         :deps/root "lib/kotoba.jpGoDigitalDesignSystem"}}
 :aliases
 {;; This alias held an :override-deps entry for the retired coordinate
  ;; io.github.com-junkawasaki/langchain-clj. langgraph declares the same
  ;; library as io.github.kotoba-lang/langchain, so the entry matched no
  ;; node in the resolved tree and never reached the classpath -- verified
  ;; with `kbb -Stree`/-Spath, unchanged before and after removal.
  :dev {}
  ;; kbb -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "finishing.sim"]}
  ;; kbb -M:dev:render-html [out-file] -> regenerate
  ;; docs/samples/operator-console.html by driving the REAL actor stack
  ;; (finishing.operation -> finishing.governor -> finishing.store).
  ;; Flagship checklist item 2. Deterministic: byte-identical across reruns.
  :render-html {:main-opts ["-m" "finishing.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
